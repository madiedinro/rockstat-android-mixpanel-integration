<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest for the Mixpanel SDK debug sample.

  All Mixpanel tuning lives in <meta-data> entries below. The full list of supported keys is in
  MPConfig.java of the SDK:
  https://github.com/mixpanel/mixpanel-android/blob/master/analytics/src/main/java/com/mixpanel/android/mpmetrics/MPConfig.java
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to send data to Mixpanel. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Optional but recommended: lets the SDK avoid flushing while offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Optional: lets the SDK report $bluetooth_enabled on Android 11 and older. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <application
        android:name=".DebugApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- ===== Debugging knobs: verbose SDK logs and aggressive flushing ===== -->

        <!-- Print every request/response the SDK makes to logcat (tags "MixpanelAPI.*"). -->
        <meta-data
            android:name="com.mixpanel.android.MPConfig.EnableDebugLogging"
            android:value="true" />

        <!-- Flush queued data every 5 seconds instead of the default 60. -->
        <meta-data
            android:name="com.mixpanel.android.MPConfig.FlushInterval"
            android:value="5000" />

        <!-- Flush as soon as 5 records are queued (default 40). -->
        <meta-data
            android:name="com.mixpanel.android.MPConfig.BulkUploadLimit"
            android:value="5" />

        <!-- Minimum $ae_session length in ms (default 10000). -->
        <meta-data
            android:name="com.mixpanel.android.MPConfig.MinimumSessionDuration"
            android:value="3000" />

        <!-- Send "$app_open" when the SDK is initialised (disabled by default). -->
        <meta-data
            android:name="com.mixpanel.android.MPConfig.DisableAppOpenEvent"
            android:value="false" />

        <!-- ===== Custom ingestion endpoints (proxy) =====
             Leave com.mixpanel.android.MPConfig.UseIpAddressForGeolocation UNSET: when it is
             present the SDK appends "?ip=0|1" to these URLs, when absent they are used verbatim. -->
        <meta-data
            android:name="com.mixpanel.android.MPConfig.EventsEndpoint"
            android:value="https://mostbet.com/an/app-track/events/11/" />
        <meta-data
            android:name="com.mixpanel.android.MPConfig.PeopleEndpoint"
            android:value="https://mostbet.com/an/app-track/people/11/" />
        <meta-data
            android:name="com.mixpanel.android.MPConfig.GroupsEndpoint"
            android:value="https://mostbet.com/an/app-track/groups/11/" />

        <!-- Feature flags replaced the old "decide" endpoint. Uncomment to route flags through
             the proxy as well; otherwise https://api.mixpanel.com/flags/ is used.
        <meta-data
            android:name="com.mixpanel.android.MPConfig.FlagsEndpoint"
            android:value="https://mostbet.com/an/app-track/flags/11/" />
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
